    def set_log(self, logger):
        self.logger = logger

    def log(self, *args):
        self.logger.append( args )

    def start_fetch(self):
        # Utiliser create_task au lieu de ensure_future et capturer l'erreur
        try:
            # Ensure there's a running event loop
            loop = asyncio.get_event_loop()
            if not loop.is_running():
                # If no loop is running, we need to handle this differently
                print("No running event loop, using asyncio.run")
                asyncio.run(self.fetch_challenges())
            else:
                # Normal case - create task on the running loop
                task = asyncio.create_task(self.fetch_challenges())
                task.add_done_callback(lambda t: self._handle_task_exception(t, "fetch_challenges"))
        except Exception as e:
            print(f"Error starting fetch_challenges: {e}")

    def start_get_votes_panel(self, url, count):
        # Utiliser create_task au lieu de ensure_future et capturer l'erreur
        try:
            # Ensure there's a running event loop
            loop = asyncio.get_event_loop()
            if not loop.is_running():
                # If no loop is running, we need to handle this differently
                print("No running event loop, using asyncio.run")
                asyncio.run(self.fetch_get_votes_panel(url, count))
            else:
                # Normal case - create task on the running loop
                task = asyncio.create_task(self.fetch_get_votes_panel(url, count))
                task.add_done_callback(lambda t: self._handle_task_exception(t, "fetch_get_votes_panel"))
        except Exception as e:
            print(f"Error starting fetch_get_votes_panel: {e}")

    def start_post_votes_panel(self, challenge, votes_panel):
        # Utiliser create_task au lieu de ensure_future et capturer l'erreur
        try:
            # Ensure there's a running event loop
            loop = asyncio.get_event_loop()
            if not loop.is_running():
                # If no loop is running, we need to handle this differently
                print("No running event loop, using asyncio.run")
                asyncio.run(self.fetch_post_votes_panel(challenge, votes_panel))
            else:
                # Normal case - create task on the running loop
                task = asyncio.create_task(self.fetch_post_votes_panel(challenge, votes_panel))
                task.add_done_callback(lambda t: self._handle_task_exception(t, "fetch_post_votes_panel"))
        except Exception as e:
            print(f"Error starting fetch_post_votes_panel: {e}")
            
    def _handle_task_exception(self, task, task_name):
        # Fonction helper pour gérer les exceptions de tâches asyncio
        try:
            task.result()  # Récupérer le résultat ou lever l'exception
        except asyncio.CancelledError:
            print(f"Task {task_name} was cancelled")
        except Exception as e:
            print(f"Task {task_name} raised exception: {e}")

