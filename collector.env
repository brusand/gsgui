# Configuration GuruShots Collector - Bruno
# Stockage réseau SMB sur Mac mini

# Base de données principale sur réseau SMB
DATABASE_PATH=/Volumes/SSD/Data/GuruShots/gurushots_data.db

# API GuruShots (ne pas modifier)
GURUSHOTS_API_URL=https://api.gurushots.com/rest/get_top_photographer

# Configuration de collecte
COLLECTION_INTERVAL_MINUTES=30
LIMIT_ABOVE=1000
LIMIT_BELOW=1000

# Challenges à suivre (MODIFIEZ ICI VOS IDS)
# Exemple : CHALLENGE_IDS=105602,105560,105581,105622,105619,105173,105624,105608,105568,105988,105579,105609,105605,105989,105586,105176,106225,105805,106470,105681,106237,105987
CHALLENGE_IDS=105602,105560,105581,105622,105619,105173,105624,105608,105568,105988,105579,105609,105605,105989,105586,105176,106225,105805,106470,105681,106237,105987

# Logging centralisé sur réseau
LOG_LEVEL=INFO
LOG_FILE=/Volumes/SSD/Data/GuruShots/logs/gurushots_collector.log

# Chemins d'export sur réseau
EXPORT_PATH=/Volumes/SSD/Data/GuruShots/exports
VISUALIZATION_PATH=/Volumes/SSD/Data/GuruShots/visualizations

# Alertes (optionnel - laissez vide pour l'instant)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
