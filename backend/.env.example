# Environment Configuration for GSGUI Backend

# Application
APP_NAME=GSGUI Backend
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://gsgui:gsgui@localhost:5432/gsgui
TEST_DATABASE_URL=postgresql://gsgui:gsgui@localhost:5432/gsgui_test

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY=your-secret-key-change-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS
ALLOWED_HOSTS=["*"]

# GuruShots API
GURUSHOTS_API_BASE=https://api.gurushots.com/rest
GURUSHOTS_RATE_LIMIT=10

# Scheduling
SCHEDULER_TIMEZONE=UTC
MAX_CONCURRENT_STRATEGIES=50

# WebSockets
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=