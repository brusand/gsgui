# Strategies configuration file
# Bibliothèque des stratégies disponibles pour GSGUI

[DEFAULT]
description = Strategy templates for GSGUI

# === STRATEGIES DE VOTE IMMEDIAT ===
[fill]
name = Fill (vote immédiat)
type = immediate
description = Vote immédiatement avec tous les votes disponibles
votes = all_available
timing = now

[fill20]
name = Fill 20 votes
type = immediate  
description = Vote immédiatement avec 20 votes
votes = 20
timing = now

[fill70]
name = Fill 70 votes
type = immediate
description = Vote immédiatement avec 70 votes  
votes = 70
timing = now

